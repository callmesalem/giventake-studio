# Copy to .env (git-ignored) for local dev, and set the same values in your
# hosting provider's environment settings for production.
#
# Every value here is OPTIONAL. With none set, the site still works:
# analytics providers are skipped, and the contact and data-request forms fall
# back to opening the visitor's mail client.

# --- Form intake (server-side, secret) -------------------------------------
# Without RESEND_API_KEY and INTAKE_FROM_EMAIL the forms use the mailto:
# fallback. Adding a provider makes it a data processor: add it to the privacy
# policy and docs/contracts/subprocessor-list.md BEFORE it goes live.
RESEND_API_KEY=
# Verified sender on a domain you control, e.g. "GivenTake <noreply@giventakedevs.com>"
INTAKE_FROM_EMAIL=
# Where enquiries land. Defaults to hello@giventakedevs.com (contact form) and
# privacy@giventakedevs.com (data-request form) when unset.
INTAKE_TO_EMAIL=

# --- Analytics and advertising pixels (client-side, public) -----------------
# All are consent-gated in src/lib/tracking.ts and load nothing until the
# visitor accepts. Leave unset for any platform you are not actually running
# ads on — and remove it from the privacy policy too, rather than disclosing a
# processor you don't use.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
# Optional Google Ads event snippet label for successful contact-form conversions.
VITE_GOOGLE_ADS_LEAD_CONVERSION_LABEL=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
# Optional numeric event-specific conversion ID for successful contact forms.
VITE_LINKEDIN_LEAD_CONVERSION_ID=
VITE_MICROSOFT_UET_TAG_ID=

# --- Video Agent Studio (server-side, local development only) --------------
# The current Studio route is intentionally available only during local
# development. Do not set these values on the public website deployment until
# authenticated tenant membership is implemented.
STUDIO_TENANT_ID=
STUDIO_ACTOR_ID=

# Reserved for the VPS worker release. Keep the fixture provider until a
# provider adapter, storage, worker authentication, and a production database
# have all been deployed together.
STUDIO_WORKER_SHARED_SECRET=
STUDIO_STORAGE_BUCKET=
STUDIO_STORAGE_ENDPOINT=
STUDIO_STORAGE_ACCESS_KEY=
STUDIO_STORAGE_SECRET_KEY=
STUDIO_VIDEO_PROVIDER=fixture
STUDIO_VIDEO_PROVIDER_API_KEY=
STUDIO_COMFYUI_ENDPOINT=
STUDIO_OUTBOUND_KILL_SWITCH=true
