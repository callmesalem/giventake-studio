# Required secret. Generate with: openssl rand -hex 32
STUDIO_WORKER_SHARED_SECRET=replace-with-a-64-character-hex-secret

# Safe defaults. Keep these values for installation and health checks.
STUDIO_OUTBOUND_KILL_SWITCH=true
STUDIO_VIDEO_PROVIDER=fixture
STUDIO_WORKER_PROVIDER_RATES_JSON={"fixture":{"fixture":0}}

# The Docker service binds to localhost. Put a private TLS reverse proxy in
# front of it only after the Studio application has authenticated persistence.
STUDIO_WORKER_HOST=0.0.0.0
STUDIO_WORKER_PORT=8788
STUDIO_WORKER_DATA_DIR=/var/lib/giventake-video-worker
STUDIO_WORKER_OUTPUT_DIR=/var/lib/giventake-video-worker/outputs
STUDIO_WORKER_LEASE_MS=300000
STUDIO_WORKER_POLL_INTERVAL_MS=1000
